# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGO_URI=mongodb://localhost:27017/employee-directory

# Database Connection Pool Monitoring
MONITOR_DB_POOL=false
DB_POOL_MONITOR_INTERVAL=60000

# Cache Configuration
CACHE_MAX_SIZE=104857600
CACHE_MAX_ITEMS=1000
CACHE_DEFAULT_TTL=300000

# Employee Cache Settings
EMPLOYEE_CACHE_SIZE=52428800
EMPLOYEE_CACHE_ITEMS=500
EMPLOYEE_CACHE_TTL=300000

# Department Cache Settings
DEPARTMENT_CACHE_SIZE=1048576
DEPARTMENT_CACHE_ITEMS=100
DEPARTMENT_CACHE_TTL=600000

# CORS Configuration (Comma-separated list of allowed origins)
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Security Configuration

# Rate Limiting Whitelist (Comma-separated list of IP addresses)
# Example: RATE_LIMIT_WHITELIST=127.0.0.1,::1
RATE_LIMIT_WHITELIST=

# Request Size Limits
MAX_JSON_SIZE=100kb
MAX_URLENCODED_SIZE=100kb
MAX_PARAMETER_COUNT=50

# Request Timeout (in milliseconds)
REQUEST_TIMEOUT_MS=30000

# Security Headers
# Set to 'true' in production to enforce HTTPS
FORCE_HTTPS=false

# Authentication Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_SECRET=your-super-secret-refresh-token-key-change-this-in-production
REFRESH_TOKEN_EXPIRES_IN=7d
